TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=your_auth_secret_goes_here
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Local email transport (Mailpit). Points at the Mailpit HTTP send API, which
# runs on the same port as its web UI; sent messages appear in that UI.
MAILPIT_URL=http://localhost:8025
# Default sender address. Only used by the local Mailpit transport in dev,
# when MAILPIT_URL is set. In production the sender comes from EMAIL_FROM in
# wrangler.jsonc vars.
EMAIL_FROM=no-reply@your-domain.example.com

# LLM question generation (issue #79). OPENCODE_API_KEY authenticates
# against the OpenCode gateway; OPENCODE_BASE_URL optionally overrides
# the chat completions endpoint (for a local stand-in service).
# NOTE: local dev runs SSR inside workerd (the cloudflare vite plugin),
# which ignores this file and the shell environment. Put both values in
# .dev.vars as well — see .dev.vars.example. In production, set the key
# once with: wrangler secret put OPENCODE_API_KEY
OPENCODE_API_KEY=
OPENCODE_BASE_URL=