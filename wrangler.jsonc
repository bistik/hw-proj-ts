{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hw-proj-ts",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-02",
  // Cloudflare Email Service binding. `remote: true` lets local dev (vite dev /
  // wrangler dev) call the real service; production email failover is handled
  // in src/lib/email/send.ts, which prefers Mailpit when MAILPIT_URL is set.
  // https://developers.cloudflare.com/email-service/get-started/send-emails/
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
  // Non-secret worker vars. EMAIL_FROM must be an address on the email domain
  // onboarded in the Cloudflare dashboard (Email Service > Email Sending).
  // Change it here; it deploys with `wrangler deploy`. Add more non-secret
  // config here, secrets go through `wrangler secret put <NAME>` instead —
  // for example OPENCODE_API_KEY, the LLM gateway key for question
  // generation (issue #79). For local dev, copy .dev.vars.example to
  // .dev.vars: workerd ignores the shell environment.
  "vars": {
    "EMAIL_FROM": "no-reply@ldh.bianes.dev",
    // LLM question generation (issue #79), read from process.env by
    // src/lib/ai/llm.ts. Both values equal the code defaults, so
    // behavior does not change; edit them here to re-point production
    // without a code deploy. Local dev overrides them through
    // .dev.vars (see .dev.vars.example).
    "OPENCODE_MODEL": "mimo-v2.6-flash",
    "OPENCODE_BASE_URL": "https://opencode.ai/inference/go/openai/v1",
  },
  "observability": {
    "enabled": true,
  },
}
